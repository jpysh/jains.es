# Response headers for jains.es, applied by Cloudflare Workers Static Assets.
#
# public/ is copied verbatim into dist/ by the Vite build, so this file ships as-is.
#
# The policy below was derived from the built output rather than guessed:
#   - the only executable script is /assets/main-*.js, same-origin, so script-src is 'self'
#     with no 'unsafe-inline'. The 59 <script type="application/ld+json"> blocks are data,
#     never executed, and are not affected.
#   - 'unsafe-inline' IS needed in style-src: the built pages carry inline style="" attributes.
#   - fonts are self-hosted (/assets/fonts/*.woff2), so font-src stays 'self'.
#   - no iframes, no external images, no Worker/blob/eval in the bundle. OGL uses WebGL,
#     which CSP does not gate.
#   - form-action allows *.substack.com because the footer subscribe form is a plain
#     GET form posting there. That is the ONLY relaxation the newsletter needs. Do not
#     widen script-src, connect-src or frame-src for it: Substack's iframe embed would
#     need frame-src and costs 96 KB of HTML, 90 scripts and 5 cookies on every page.
# Re-check this file if the build starts emitting an inline <script> or pulling a third-party
# asset — the symptom is a silent console block, not a visible error.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://*.substack.com; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
